# Copy to deploy/.env.production and fill in real values. Never commit that file.
JOINLET_DOMAIN=joinlet.co
JOINLET_APP_DOMAIN=app.joinlet.co
JOINLET_ACME_EMAIL=
JOINLET_RELEASE=beta
STRUKT_PUBLIC_URL=https://app.joinlet.co
JOINLET_SITE_URL=https://joinlet.co
# Optional: leave both empty for email/password-only hosting.
STRUKT_GITHUB_APP_CLIENT_ID=
STRUKT_GITHUB_APP_CLIENT_SECRET=
# Optional: /telemetry enables consent-based metrics through a collector provided by the operator.
JOINLET_ANALYTICS_PATH=
# Optional installation shortcut for the repository/MCP flow.
STRUKT_GITHUB_APP_SLUG=
# Generate once: openssl rand -hex 32. Preserve this value across deploys and restores.
STRUKT_REMOTE_ENCRYPTION_KEY=
# Numeric verified GitHub IDs. Empty uses the selected deployment policy for everyone.
JOINLET_ADMIN_GITHUB_IDS=

# Self-hosted: no commercial workspace/diagram/participant quotas. Safety limits still apply.
# The official managed service explicitly uses cloud (current Free Beta policy).
JOINLET_DEPLOYMENT_MODE=self-hosted
