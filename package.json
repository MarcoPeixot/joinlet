{
  "name": "joinlet",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.4",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun run --filter @strukt/web --filter @strukt/server dev",
    "dev:server": "bun run --filter @strukt/server dev",
    "start:collab": "bun run --filter @strukt/server start:collab",
    "start:remote": "bun run --filter @strukt/remote start",
    "build": "bun run --filter @strukt/web build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "e2e": "bun run --filter @strukt/web e2e",
    "verify:knowledge": "bun apps/cli/src/main.ts verify --strict",
    "test:remote-smoke": "bun apps/remote/src/deploymentSmoke.ts",
    "backup:remote": "bun apps/remote/src/backup.ts",
    "build:connector": "bun run build && bun scripts/build-connector.ts",
    "start:repository-worker": "bun apps/remote/src/repositoryWorker.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sass": "1.105.2",
    "lodash-es": "4.18.1",
    "source-map-js": "1.2.2",
    "katex": "0.18.2",
    "nanoid@3": "3.3.18",
    "nanoid@4": "5.1.16",
    "ip-address": "10.7.4",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "zod": "4.6.6"
  },
  "license": "AGPL-3.0-only"
}
