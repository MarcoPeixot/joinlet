# Copie para apps/server/.env (ignorado pelo git). As chaves ficam só no servidor.
# Também dá para configurar pelo app (Configurações › IA): a chave vai para ~/.config/strukt/settings.json
# (permissão 600, fora do repositório). Uma variável definida aqui tem prioridade sobre a do arquivo.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OpenCode Zen: conexão independente para modelos de chat.
OPENCODE_API_KEY=
# Assinatura OpenCode Go / Go Plus, independente da conexão Zen.
OPENCODE_GO_API_KEY=
# Conexões independentes (opcionais); também configuráveis no app.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Servidor compatível com OpenAI (OpenAI, Groq, Ollama, LM Studio): o endereço e o modelo ficam em Configurações › IA; a chave é opcional.
OPENAI_API_KEY=
# OAuth App Client ID (enable Device Flow; no Client Secret); token/refresh token stay in ~/.config/strukt/github-auth.json (0600).
STRUKT_GITHUB_CLIENT_ID=
# STRUKT_CONFIG_DIR=~/.config/strukt
PORT=8787
# HOST=127.0.0.1 — não use 0.0.0.0: exporia a chave para a rede
# O servidor só aceita /api de páginas do próprio app (localhost:5178 e :4173). Se o Vite roda em outra porta, liste a origem:
# STRUKT_ALLOWED_ORIGINS=http://localhost:5179

# Pesquisa na web do chat: DuckDuckGo HTML funciona sem chave adicional.
# Opcional: use a API oficial do Brave como buscador (independente do provider de IA).
BRAVE_SEARCH_API_KEY=

# Legacy local administrator identity. Local use has no commercial quotas by default.
# This does not change authentication, roles or the hosted service.
JOINLET_LOCAL_ADMIN=0
