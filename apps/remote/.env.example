# URL pública do serviço, com HTTPS. Cadastre https://seu-dominio/github/callback na GitHub App.
STRUKT_PUBLIC_URL=https://app.joinlet.co
JOINLET_SITE_URL=https://joinlet.co
STRUKT_GITHUB_APP_CLIENT_ID=
STRUKT_GITHUB_APP_CLIENT_SECRET=
STRUKT_GITHUB_APP_SLUG=
# Gere com: openssl rand -hex 32. Preserve a chave entre reinícios.
STRUKT_REMOTE_ENCRYPTION_KEY=
# Caminho em volume persistente; por padrão apps/remote/data/remote.sqlite.
STRUKT_REMOTE_DB=
PORT=8788

# GitHub numeric user IDs verified by OAuth, comma-separated. Empty = regular Beta for everyone.
# Set this in the deployed service environment; .env is not committed.
JOINLET_ADMIN_GITHUB_IDS=

# Production requires HTTPS. Trust only the number of proxies actually in front of this service.
NODE_ENV=production
JOINLET_TRUST_PROXY_HOPS=1
